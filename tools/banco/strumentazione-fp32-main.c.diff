+/* ===== STRUMENTAZIONE DEL BANCO - non fa parte del gioco ==================
+ * Un solo binario, due modalita' scelte da FROSTMARK_BANCO:
+ *   (assente)  costo   - 75 s di scena con la visuale che ruota, e il tempo
+ *                        del solo passaggio principale
+ *   "rumore"   rumore  - 60 fotogrammi consecutivi da una posizione fissa,
+ *                        e la differenza media fra fotogrammi consecutivi
+ *
+ * La posizione del rumore e' scritta qui e non scelta a caso. Nel campo
+ * visivo ci sono 51 prop Poly Haven con normal map VERA - 37 massi e 14
+ * cespugli - da 17 a 136 m, 24 dei quali oltre i 90 m, sul nevaio a nord-est
+ * senza un albero che li copra. Guardare in una foresta non serviva: li' la
+ * scena e' fatta di alberi di cartone, che una normal map vera non ce l'hanno,
+ * e la prova avrebbe misurato terreno e cielo. */
+#include "rlgl.h"
+#include <math.h>
+#include "raymath.h"   /* BANCO fp32: matrici e Vector3Normalize */
+#include "light.h"     /* BANCO fp32: sole, proiezione, uniformi */
+
+#define BANCO_SECONDI        75.0
+#define BANCO_YAW_PASSO      0.013f   /* radianti per fotogramma */
+
+#define BANCO_RUMORE_X       2350.0f
+#define BANCO_RUMORE_Z       2300.0f
+#define BANCO_RUMORE_YAW     1.04719755f   /* 60 gradi: verso nord-est */
+#define BANCO_RUMORE_PITCH   (-0.10f)      /* in giu': il nevaio, non il cielo */
+#define BANCO_RUMORE_PASSO   0.01f         /* metri per fotogramma */
+#define BANCO_RUMORE_N       60
+#define BANCO_RUMORE_SCALDA  40
+
+/* ---- Modalita' FP32 -------------------------------------------------------
+ * Un solo masso, disegnato due volte alla stessa distanza e con lo stesso
+ * sguardo, in due punti opposti del mondo. Tutto e' relativo al masso, quindi
+ * in aritmetica esatta i due PNG sarebbero identici bit per bit: cio' che li
+ * separa e' solo fp32.
+ *
+ * Niente terreno, niente entita', niente ombre: a 64,64 e a 4032,4032 la quota
+ * del terreno e le matrici della luce sono DIVERSE, e sono differenze vere che
+ * coprirebbero quella cercata. */
+#define BANCO_FP32_SCALDA  5       /* fotogrammi buttati prima dello scatto */
+#define BANCO_FP32_ALTO    1.1f    /* meta' altezza del masso, in metri      */
+
+extern double gPassoMs;    /* game.c */
+extern long   gPassoN;
+/* ========================================================================= */
+
 int main(int argc, char **argv)
 {
     /* --valida carica dati e mondo, elenca i problemi ed esce: si usa
@@ -84,10 +129,13 @@
 
     PreferGPUOnWSL();
 
-    SetConfigFlags(FLAG_MSAA_4X_HINT | FLAG_WINDOW_RESIZABLE | FLAG_VSYNC_HINT);
+    /* BANCO: niente vsync e niente tetto di fotogrammi - con il vsync acceso
+     * la GPU resta ferma meta' del tempo e si raccolgono meno campioni.
+     * Finestra nascosta: la prova normalmap.c lo fa gia' con successo su
+     * questa macchina, e toglie di mezzo il compositore. */
+    SetConfigFlags(FLAG_MSAA_4X_HINT | FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_HIDDEN);
     InitWindow(SCREEN_W, SCREEN_H, GAME_NAME " " GAME_VERSION);
     SetExitKey(KEY_NULL);          /* ESC serve al menu, non per uscire */
-    SetTargetFPS(60);
 
     static Game game;              /* statico: la struttura e' grande        */
     if (!GameInit(&game)) {
@@ -97,35 +145,232 @@
         return 1;
     }
 
-    /* Passo fisso: la simulazione avanza sempre di SIM_STEP, indipendentemente
-     * dal frame rate. Serve alla fisica, che con un dt variabile cambia
-     * comportamento, e rende il gioco riproducibile. L'input si legge una volta
-     * per fotogramma, la simulazione puo' girare piu' volte per recuperare. */
-    double accumulator = 0.0;
-
-    while (!WindowShouldClose() && game.running) {
-        double frame = GetFrameTime();
-        if (frame > SIM_MAX_FRAME) frame = SIM_MAX_FRAME;  /* dopo un freeze,
-                                                              non si recupera
-                                                              all'infinito */
-        accumulator += frame;
-
-        GameInput(&game);
-
-        int steps = 0;
-        while (accumulator >= SIM_STEP && steps < SIM_MAX_STEPS) {
-            GameSimulate(&game, (float)SIM_STEP);
-            accumulator -= SIM_STEP;
-            steps++;
-        }
-        if (steps == SIM_MAX_STEPS) accumulator = 0.0;      /* rinuncia al resto */
-
-        GameUpdateCamera(&game);
-
-        BeginDrawing();
-            ClearBackground(BLACK);
-            GameDraw(&game);
-        EndDrawing();
+    const char *modo = getenv("FROSTMARK_BANCO");
+    int rumore = (modo != NULL && strcmp(modo, "rumore") == 0);
+    int fp32   = (modo != NULL && strcmp(modo, "fp32")   == 0);
+
+    if (fp32) {
+        /* ---- Modalita' FP32 (precisione) --------------------------------- */
+        float px = 64.0f, pz = 64.0f, dist = 1.0f;
+        const char *sp = getenv("FROSTMARK_FP32_POS");
+        if (sp != NULL) sscanf(sp, "%f,%f", &px, &pz);
+        const char *sd = getenv("FROSTMARK_FP32_DIST");
+        if (sd != NULL) dist = (float)atof(sd);
+
+        World *w = &game.world;
+        if (!w->hasExtProp[PROP_ROCK] || w->propVar[PROP_ROCK].n <= 0) {
+            printf("fp32: nessun modello esterno per PROP_ROCK\n");
+            fflush(stdout);
+            GameShutdown(&game);
+            CloseWindow();
+            return 1;
+        }
+
+        /* La quota e' FISSA, non WorldHeight(): il terreno e' diverso nei due
+         * punti e il masso si troverebbe a due altezze diverse rispetto alla
+         * camera, che e' esattamente la differenza che non vogliamo. */
+        Vector3 pos = { px, 0.0f, pz };
+
+        Vector3 sole = Vector3Normalize((Vector3){ 0.35f, 0.70f, 0.45f });
+        LightSetSun(sole, 1.0f);
+        LightSetProjection(0, 1.0f);
+        LightSetAlphaCut(0.0f);
+
+        PropVariants *pv = &w->propVar[PROP_ROCK];
+        Model *mo = &w->extProp[PROP_ROCK];
+        /* Variante FISSA a 0, non PropVariantOf(): quella sceglie dalla
+         * POSIZIONE, quindi a 64,64 e a 4032,4032 disegnerebbe due massi
+         * DIVERSI e il confronto misurerebbe la differenza fra due modelli.
+         * E' la trappola piu' facile di questa modalita'. */
+        float k = pv->scala[0];
+        Matrix mt = MatrixMultiply(MatrixScale(k, k, k),
+                                   MatrixTranslate(pos.x, pos.y, pos.z));
+
+        /* L'inquadratura si CALCOLA dall'ingombro, non si indovina. Con una
+         * quota fissa a occhio il masso usciva decentrato e riempiva un terzo
+         * del fotogramma: e' la trappola scritta nel piano, perche' la
+         * differenza media si divide per i pixel di sfondo nero, che sono
+         * identici nelle due esecuzioni per costruzione e quindi diluiscono
+         * proprio il numero che si vuole leggere.
+         *
+         * 'dist' resta la distanza dalla SUPERFICIE, non dal centro: e' la
+         * grandezza di cui parla il conto degli ulp. */
+        BoundingBox bb = { 0 };
+        for (int j = 0; j < pv->gruppo[0].count; j++) {
+            int mi = pv->meshIdx[pv->gruppo[0].first + j];
+            BoundingBox mb = GetMeshBoundingBox(mo->meshes[mi]);
+            if (j == 0) bb = mb;
+            else {
+                bb.min.x = fminf(bb.min.x, mb.min.x);
+                bb.min.y = fminf(bb.min.y, mb.min.y);
+                bb.min.z = fminf(bb.min.z, mb.min.z);
+                bb.max.x = fmaxf(bb.max.x, mb.max.x);
+                bb.max.y = fmaxf(bb.max.y, mb.max.y);
+                bb.max.z = fmaxf(bb.max.z, mb.max.z);
+            }
+        }
+        Vector3 centro = { pos.x + (bb.min.x + bb.max.x) * 0.5f * k,
+                           pos.y + (bb.min.y + bb.max.y) * 0.5f * k,
+                           pos.z + (bb.min.z + bb.max.z) * 0.5f * k };
+        float semiZ = (bb.max.z - bb.min.z) * 0.5f * k;
+
+        Camera3D cam = { 0 };
+        cam.position   = (Vector3){ centro.x, centro.y, centro.z + semiZ + dist };
+        cam.target     = centro;
+        cam.up         = (Vector3){ 0.0f, 1.0f, 0.0f };
+        cam.fovy       = 70.0f;
+        cam.projection = CAMERA_PERSPECTIVE;
+
+        for (int f = 0; f <= BANCO_FP32_SCALDA; f++) {
+            BeginDrawing();
+                ClearBackground(BLACK);
+                LightFrame(cam);
+                BeginMode3D(cam);
+                    for (int j = 0; j < pv->gruppo[0].count; j++) {
+                        int mi  = pv->meshIdx[pv->gruppo[0].first + j];
+                        int mat = (mo->meshMaterial != NULL)
+                                    ? mo->meshMaterial[mi] : 0;
+                        if (mat < 0 || mat >= mo->materialCount) mat = 0;
+                        DrawMesh(mo->meshes[mi], mo->materials[mat], mt);
+                    }
+                EndMode3D();
+                rlDrawRenderBatchActive();
+                if (f == BANCO_FP32_SCALDA) {
+                    Image im = LoadImageFromScreen();
+                    if (im.data != NULL) {
+                        const char *scatto = getenv("FROSTMARK_SCATTO");
+                        ExportImage(im, scatto != NULL ? scatto
+                                                       : "banco_fp32.png");
+                        printf("fp32: pos=%.1f,%.1f dist=%.2f semiZ=%.2f "
+                               "alto=%.2f %dx%d\n", px, pz, dist, semiZ,
+                               (bb.max.y - bb.min.y) * k, im.width, im.height);
+                        UnloadImage(im);
+                    }
+                }
+            EndDrawing();
+        }
+        fflush(stdout);
+    } else if (!rumore) {
+        /* ---- Modalita' COSTO --------------------------------------------
+         * Il giocatore resta al punto di partenza e la visuale RUOTA di un
+         * passo fisso a ogni fotogramma: cosi' si campionano tutte le
+         * direzioni invece di una sola, e l'insieme degli yaw visitati e'
+         * lo stesso in tutte le esecuzioni - non dipende da quanto e' veloce
+         * la macchina. Niente GameInput e niente GameSimulate: la scena deve
+         * essere la stessa in tutte le esecuzioni, o si misura il caso. */
+        double t0 = GetTime();
+        while (!WindowShouldClose() && game.running) {
+            game.player.yaw += BANCO_YAW_PASSO;
+            GameUpdateCamera(&game);
+            BeginDrawing();
+                ClearBackground(BLACK);
+                GameDraw(&game);
+            EndDrawing();
+            if (GetTime() - t0 >= BANCO_SECONDI) break;
+        }
+        printf("fotogrammi=%ld passo_medio_ms=%.3f\n",
+               gPassoN, gPassoN > 0 ? gPassoMs / (double)gPassoN : 0.0);
+        fflush(stdout);
+    } else {
+        /* ---- Modalita' RUMORE -------------------------------------------
+         * Posizione fissa e riproducibile, camera che avanza di un passo
+         * piccolo e uguale a ogni fotogramma lungo la direzione dello
+         * sguardo. Il movimento serve: fermi, i fotogrammi sarebbero
+         * identici e la varianza sarebbe zero in tutte e due le copie. */
+        game.player.camMode = CAM_FIRST;
+        game.player.yaw   = BANCO_RUMORE_YAW;
+        game.player.pitch = BANCO_RUMORE_PITCH;
+        game.player.pos.x = BANCO_RUMORE_X;
+        game.player.pos.z = BANCO_RUMORE_Z;
+        game.player.pos.y = WorldHeight(&game.world, BANCO_RUMORE_X,
+                                        BANCO_RUMORE_Z);
+        game.player.vel = (Vector3){ 0.0f, 0.0f, 0.0f };
+        for (int i = 0; i < 400; i++)
+            WorldUpdateStreaming(&game.world, game.player.pos);
+
+        float dirx = sinf(BANCO_RUMORE_YAW);
+        float dirz = cosf(BANCO_RUMORE_YAW);
+
+        int w = SCREEN_W, h = SCREEN_H;
+        float *lum  = NULL, *prev = NULL, *acc = NULL;
+        double somma = 0.0, massimo = 0.0;
+        long   coppie = 0, cambiati = 0, pixel = 0;
+
+        for (int f = 0; f < BANCO_RUMORE_SCALDA + BANCO_RUMORE_N; f++) {
+            if (f >= BANCO_RUMORE_SCALDA) {
+                int k = f - BANCO_RUMORE_SCALDA;
+                game.player.pos.x = BANCO_RUMORE_X + dirx * BANCO_RUMORE_PASSO * (float)k;
+                game.player.pos.z = BANCO_RUMORE_Z + dirz * BANCO_RUMORE_PASSO * (float)k;
+            }
+            GameUpdateCamera(&game);
+            BeginDrawing();
+                ClearBackground(BLACK);
+                GameDraw(&game);
+                rlDrawRenderBatchActive();   /* il batch va svuotato PRIMA di
+                                                leggere il fotogramma */
+                if (f >= BANCO_RUMORE_SCALDA) {
+                    Image im = LoadImageFromScreen();
+                    if (im.data == NULL) { EndDrawing(); break; }
+                    if (lum == NULL) {
+                        w = im.width; h = im.height;
+                        pixel = (long)w * (long)h;
+                        lum  = (float *)malloc((size_t)pixel * sizeof(float));
+                        prev = (float *)malloc((size_t)pixel * sizeof(float));
+                        acc  = (float *)calloc((size_t)pixel, sizeof(float));
+                    }
+                    if (lum != NULL && prev != NULL &&
+                        (long)im.width * (long)im.height == pixel) {
+                        const unsigned char *p = (const unsigned char *)im.data;
+                        for (long i = 0; i < pixel; i++)
+                            lum[i] = 0.2126f * (float)p[i * 4 + 0]
+                                   + 0.7152f * (float)p[i * 4 + 1]
+                                   + 0.0722f * (float)p[i * 4 + 2];
+                        if (f > BANCO_RUMORE_SCALDA) {
+                            double s = 0.0;
+                            for (long i = 0; i < pixel; i++) {
+                                double d = lum[i] - prev[i];
+                                if (d < 0.0) d = -d;
+                                s += d;
+                                if (acc != NULL) acc[i] += (float)d;
+                                if (d > massimo) massimo = d;
+                                if (d >= 0.5) cambiati++;
+                            }
+                            somma += s / (double)pixel;
+                            coppie++;
+                        }
+                        float *t = prev; prev = lum; lum = t;
+                    }
+                    if (f == BANCO_RUMORE_SCALDA) {
+                        const char *scatto = getenv("FROSTMARK_SCATTO");
+                        ExportImage(im, scatto != NULL ? scatto
+                                                       : "banco_inquadratura.png");
+                    }
+                    UnloadImage(im);
+                }
+            EndDrawing();
+        }
+        printf("diff_media=%.4f coppie=%ld pixel=%ld "
+               "frazione_cambiati=%.5f diff_max=%.2f\n",
+               coppie > 0 ? somma / (double)coppie : 0.0, coppie, pixel,
+               (coppie > 0 && pixel > 0)
+                   ? (double)cambiati / ((double)coppie * (double)pixel) : 0.0,
+               massimo);
+        fflush(stdout);
+        /* La mappa per pixel della varianza temporale: senza, si sa solo che
+         * la media su tutto lo schermo cambia poco, e non si sa se il poco sta
+         * tutto sui massi o e' sparso sul nevaio. */
+        const char *mappa = getenv("FROSTMARK_MAPPA");
+        if (mappa != NULL && acc != NULL && coppie > 0) {
+            FILE *fm = fopen(mappa, "wb");
+            if (fm != NULL) {
+                for (long i = 0; i < pixel; i++) acc[i] /= (float)coppie;
+                fwrite(acc, sizeof(float), (size_t)pixel, fm);
+                fclose(fm);
+            }
+        }
+        free(acc);
+        free(lum);
+        free(prev);
     }
 
     GameShutdown(&game);
