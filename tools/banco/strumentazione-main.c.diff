+#define BANCO_RUMORE_X       2350.0f
+#define BANCO_RUMORE_Z       2300.0f
+#define BANCO_RUMORE_YAW     1.04719755f   /* 60 gradi: verso nord-est */
+#define BANCO_RUMORE_PITCH   (-0.10f)      /* in giu': il nevaio, non il cielo */
+#define BANCO_RUMORE_PASSO   0.01f         /* metri per fotogramma */
+#define BANCO_RUMORE_N       60
+#define BANCO_RUMORE_SCALDA  40
+
+extern double gPassoMs;    /* game.c */
+extern long   gPassoN;
